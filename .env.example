# Chave da Gemini API (Google AI Studio: aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo da Live API
GEMINI_LIVE_MODEL=gemini-3.8-live
# Voz pré-definida da Gemini (ex.: Charon, Puck, Kore, Fenrir, Aoede, Orus)
JARVIS_VOICE=Charon
# Cidade padrão para o clima
JARVIS_CITY=Maceió
# Como o Jarvis chama você no prompt
JARVIS_USER_NAME=Luca
PORT=8000
# Modelo de texto usado para a memória (reflexão ao fim de cada conversa)
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Busca: duckduckgo (grátis) ou google (busca embutida da Gemini, exige faturamento)
JARVIS_SEARCH=duckduckgo

# ---- Jarvis na nuvem (portaria, Dockerfile). Valores só nas variáveis do Coolify, nunca aqui.
PORTARIA_URL=https://jarvis.exemplo.com
PORTARIA_ADMIN_TOKEN=
PORTARIA_ADMIN_NOME=
PORTARIA_BACKUP_CHAVE=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
